{
  "name": "minimax-mehfil",
  "version": "1.0.0",
  "private": true,
  "description": "Mini Mehfil — a tiny local song room for MiniMax Music 3",
  "scripts": {
    "start": "node server.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 eslint.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json",
    "test": "node --test"
