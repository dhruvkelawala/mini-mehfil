{
  "name": "minimax-mehfil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mini Mehfil — a tiny local song room for MiniMax Music 3",
  "scripts": {
    "start": "node src/server/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 eslint.config.ts playwright.config.ts vitest.config.ts vitest.worker.config.ts vercel.mjs src api test/room test/worker test/browser test/fixtures test/server",
    "typecheck": "tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.room.json && tsc --noEmit -p tsconfig.client.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "test:browser": "playwright test",
    "test:unit": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts --configLoader native",
    "build:listener": "vite build --mode listener",
    "worker:types": "wrangler types worker-configuration.d.ts --config share/wrangler.jsonc",
    "worker:types:check": "wrangler types --check worker-configuration.d.ts --config share/wrangler.jsonc",
    "worker:dry-run": "wrangler deploy --dry-run --config share/wrangler.jsonc"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-solid": "^0.15.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
