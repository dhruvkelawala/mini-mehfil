{
  "name": "minimax-mehfil",
  "version": "1.0.0",
  "private": true,
  "description": "Mini Mehfil — a tiny local song room for MiniMax Music 3",
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js test/*.test.mjs",
    "test:unit": "node --test test/*.test.js test/*.test.mjs",
    "test:browser": "playwright test --project=chromium",
    "test:all": "npm run test:unit && npm run test:browser",
    "typecheck": "tsc --project tsconfig.node.json"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  }
}
