    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/node": "^24.13.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-solid": "^0.15.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
