{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-mehfil-share",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-14",
  "r2_buckets": [
    {
      "binding": "SHARES",
      "bucket_name": "mini-mehfil-shares"
    }
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
