{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": [
      "./worker-configuration.d.ts",
      "vitest/globals",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "src/room/**/*.ts",
    "src/worker/**/*.ts",
    "test/worker/**/*.ts",
    "worker-configuration.d.ts"
  ]
}
