{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "eslint.config.ts",
    "vite.config.ts",
    "vitest*.config.ts",
    "playwright.config.ts",
    "scripts/**/*.ts",
    "test/browser/**/*.ts",
    "test/fixtures/**/*.ts"
  ]
}
